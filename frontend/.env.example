# Frontend build-time environment. Copy to `.env.local` only if you need to override defaults.
# Every VITE_* value is inlined into the public JS bundle — never put secrets here.

# Base URL of the backend API, with no trailing slash.
# Leave EMPTY for local dev: Vite proxies /health to http://localhost:3001 (see vite.config.ts).
# In deploys, CI sets this to the Lambda Function URL, discovered at deploy time.
VITE_API_BASE_URL=

# Git commit the bundle was built from. CI sets this to $GITHUB_SHA; unset locally.
VITE_COMMIT_SHA=

# --- Supabase, for anonymous sign-in --------------------------------------------------------
#
# The browser signs a visitor in anonymously on first load and puts the resulting access token on
# every /api request; the backend serves each request as that user, so row-level security is what
# keeps one session's goals away from another's. Without these two the app still renders — it says
# it has nowhere to keep goals yet, calmly — but nothing can be saved.
#
# BOTH ARE PUBLIC. They are inlined into the JS bundle, exactly like VITE_API_BASE_URL, and that
# is fine by design: the anon key grants nothing on its own. The SERVICE ROLE key is a different
# thing entirely and must never appear in this file or anywhere else in frontend/.
#
# In deploys, `deploy.yml` must pass both to the frontend build step, from the GitHub secrets that
# already exist for the backend (SUPABASE_URL, SUPABASE_ANON_KEY).

# Project URL, no trailing slash, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The project's `anon` / publishable key.
VITE_SUPABASE_ANON_KEY=
