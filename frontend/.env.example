# Frontend build-time environment. Copy to `.env.local` only if you need to override defaults.
# Every VITE_* value is inlined into the public JS bundle — never put secrets here.

# Base URL of the backend API, with no trailing slash.
# Leave EMPTY for local dev: Vite proxies /health to http://localhost:3001 (see vite.config.ts).
# In deploys, CI sets this to the Lambda Function URL, discovered at deploy time.
VITE_API_BASE_URL=

# Git commit the bundle was built from. CI sets this to $GITHUB_SHA; unset locally.
VITE_COMMIT_SHA=
