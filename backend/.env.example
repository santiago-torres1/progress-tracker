# progress-tracker backend: local environment.
#
# Copy to backend/.env (gitignored) and fill in what you need. `npm run dev` and `npm start`
# load it automatically; variables already set in your shell win. The Lambda never reads .env:
# in AWS these are set on the function by the deploy workflow, from GitHub secrets.
#
# Placeholders only. Never put real values in this file. An empty value counts as unset.

# Port for the local dev server. Ignored on Lambda.
PORT=3001

# --- Supabase ---------------------------------------------------------------------------------
# Supabase dashboard -> your project. If any of the three is empty, GET /health/db reports
# "unconfigured", which is the expected state for local dev without a Supabase project.

# Project URL, e.g. https://<project-ref>.supabase.co
# Found under Project Settings -> Data API (or the "Connect" button).
SUPABASE_URL=

# Public "anon" key (Project Settings -> API Keys). Designed to be public: everything it can do
# is limited by Row Level Security policies. Every /api request builds a client from this key
# PLUS the caller's own access token, so PostgREST applies RLS as that visitor.
SUPABASE_ANON_KEY=

# "service_role" key (Project Settings -> API Keys). SERVER-SIDE ONLY, MAINTENANCE ONLY.
# It bypasses Row Level Security entirely: anyone holding it has full read/write access to the
# database and can manage auth users. Never send it to the browser, never put it in a VITE_*
# variable, never log it, never commit it -- and never use it to serve a request: RLS is what
# isolates one anonymous session from another, and this key would silently defeat it. The only
# things that may use it are GET /health/db and scheduled maintenance jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Identity ---------------------------------------------------------------------------------
# There is nothing to configure. Identity comes from the caller: every /api request carries
# `Authorization: Bearer <supabase access token>` from anonymous sign-in, Supabase verifies it,
# and public.begin_request() resolves the account. DEFAULT_USER_ID (the single login-less user of
# 0.1.x) is gone, along with public.users.is_default and public.default_user_id().

# --- Build metadata ---------------------------------------------------------------------------
# Commit SHA reported by GET /health. In the Lambda image it is baked in at build time
# (docker build --build-arg GIT_SHA=<sha>). Leave empty locally to report "local".
GIT_SHA=
